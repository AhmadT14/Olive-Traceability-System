# Copy to .env (never commit .env).
# Docker Compose fills in DATABASE_URL, RPC_URL and the contract addresses
# itself; the values below are what the backend needs besides those.
CHAIN_ID=31337
JWT_SECRET=change-me-to-at-least-32-random-characters

# Only needed when running the backend outside Docker.
RPC_URL=http://127.0.0.1:8545
DATABASE_URL=postgres://olive_app:olive_pass@localhost:5432/olive_traceability
REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BATCH_CUSTODY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
DEPLOY_BLOCK=0
PORT=3000
